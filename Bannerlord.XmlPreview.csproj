<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MaterialDesignThemes" Version="5.3.2"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Bannerlord\**\*.cs"/>
        <Compile Remove="Core\**\*.cs"/>
        <Compile Remove="Bannerlord.XmlPreview.DemoData\**\*.cs"/>
        <Compile Remove="Bannerlord.XmlPreview.Core\**\*.cs"/>
        <Compile Remove="Bannerlord.XmlPreview.Bannerlord\**\*.cs"/>
        <Compile Remove="Models\**\*.cs"/>
        <Compile Remove="Rendering\PreviewElementDebugProperties.cs"/>
        <Compile Remove="Rendering\PrefabRenderContext.cs"/>
        <Compile Remove="Rendering\RenderedPrefabNode.cs"/>
        <Compile Remove="Interfaces\IAppSettingsService.cs"/>
        <Compile Remove="Interfaces\IAssetCatalog.cs"/>
        <Compile Remove="Interfaces\IPrefabLoader.cs"/>
        <Compile Remove="Interfaces\IPrefabRenderer.cs"/>
        <Compile Remove="Services\BannerlordAssetCatalog.cs"/>
        <Compile Remove="Services\PrefabLoader.cs"/>
        <Compile Remove="Services\PrefabRenderer.cs"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="res\Sprites\**\*.png"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Bannerlord.XmlPreview.Core\Bannerlord.XmlPreview.Core.csproj"/>
        <ProjectReference Include="Bannerlord.XmlPreview.Bannerlord\Bannerlord.XmlPreview.Bannerlord.csproj"/>
    </ItemGroup>
</Project>
